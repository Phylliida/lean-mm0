-- ============================================================
-- De-Bruijn CIC-fragment prelude in STOCK MM0.
--
-- Mirrors our own prelude/cic.mm0 (de Bruijn indices, untyped
-- definitional equality = the reduction relation), but with `shift`
-- and `subst1` as *provable relations* (per-constructor axioms)
-- instead of trusted builtins.  Because everything is de Bruijn, there
-- are NO MM0 bound variables -> no disjoint-variable conditions, no
-- alpha-renaming wall (the thing that blocked concrete computations in
-- the named lean.mm1 prelude).
--
-- This file is PURE AXIOMS (no proofs): it is the trusted spec.  The
-- emitter (db_cert.py) generates the proofs that reductions hold.
-- ============================================================

delimiter $ ( $ $ ) $;

sort nat;
term nO: nat;
term nS: nat > nat;

sort expr;
term evar: nat > expr;
term eapp: expr > expr > expr;
infixl eapp: $@$ prec 100;
term elam: expr > expr > expr;        -- elam DOMAIN BODY  (binder is positional)
term tnat: expr;                      -- the type Nat
term tzero: expr;                     -- 0
term tsucc: expr;                     -- succ  (succ n = eapp tsucc n)
term trec: expr;                      -- Nat recursor (motive/level erased: untyped demo)

sort ctx;
term cnil: ctx;

provable sort wff;

-- ---- nat arithmetic (for shift/subst index bookkeeping) ----
term padd: nat > nat > nat > wff;                       -- padd i d k  :  i + d = k
axiom padd0 (i: nat): $ padd i nO i $;
axiom paddS (i d k: nat): $ padd i d k $ > $ padd i (nS d) (nS k) $;

term nlt: nat > nat > wff;                              -- nlt a b  :  a < b
axiom nlt0 (n: nat): $ nlt nO (nS n) $;
axiom nltS (m n: nat): $ nlt m n $ > $ nlt (nS m) (nS n) $;

-- ---- shift:  shf e d c e2  =  (shift indices >= c in e by d) = e2 ----
term shf: expr > nat > nat > expr > wff;
axiom shf_nat  (d c: nat): $ shf tnat  d c tnat  $;
axiom shf_zero (d c: nat): $ shf tzero d c tzero $;
axiom shf_succ (d c: nat): $ shf tsucc d c tsucc $;
axiom shf_rec  (d c: nat): $ shf trec  d c trec  $;
axiom shf_app (f a f2 a2: expr) (d c: nat):
  $ shf f d c f2 $ > $ shf a d c a2 $ > $ shf (f @ a) d c (f2 @ a2) $;
axiom shf_lam (t b t2 b2: expr) (d c: nat):
  $ shf t d c t2 $ > $ shf b d (nS c) b2 $ > $ shf (elam t b) d c (elam t2 b2) $;
axiom shf_var_0  (i d k: nat): $ padd i d k $ > $ shf (evar i) d nO (evar k) $;
axiom shf_var_S0 (d c: nat): $ shf (evar nO) d (nS c) (evar nO) $;
axiom shf_var_SS (i d c j: nat):
  $ shf (evar i) d c (evar j) $ > $ shf (evar (nS i)) d (nS c) (evar (nS j)) $;

-- ---- subst:  sub b v j b2  =  (substitute v for index j in b) = b2 ----
term sub: expr > expr > nat > expr > wff;
axiom sub_nat  (v: expr) (j: nat): $ sub tnat  v j tnat  $;
axiom sub_zero (v: expr) (j: nat): $ sub tzero v j tzero $;
axiom sub_succ (v: expr) (j: nat): $ sub tsucc v j tsucc $;
axiom sub_rec  (v: expr) (j: nat): $ sub trec  v j trec  $;
axiom sub_app (f a f2 a2 v: expr) (j: nat):
  $ sub f v j f2 $ > $ sub a v j a2 $ > $ sub (f @ a) v j (f2 @ a2) $;
axiom sub_lam (t b t2 b2 v: expr) (j: nat):
  $ sub t v j t2 $ > $ sub b v (nS j) b2 $ > $ sub (elam t b) v j (elam t2 b2) $;
axiom sub_var_eq (v v2: expr) (j: nat): $ shf v j nO v2 $ > $ sub (evar j) v j v2 $;
axiom sub_var_lt (i j: nat) (v: expr): $ nlt i j $ > $ sub (evar i) v j (evar i) $;
axiom sub_var_gt (i j: nat) (v: expr): $ nlt j (nS i) $ > $ sub (evar (nS i)) v j (evar i) $;

-- ---- definitional equality (the reduction relation), untyped ----
term deq: ctx > expr > expr > wff;
axiom deq_refl  (g: ctx) (e: expr): $ deq g e e $;
axiom deq_sym   (g: ctx) (a b: expr): $ deq g a b $ > $ deq g b a $;
axiom deq_trans (g: ctx) (a b c: expr): $ deq g a b $ > $ deq g b c $ > $ deq g a c $;
axiom deq_app (g: ctx) (f a f2 a2: expr):
  $ deq g f f2 $ > $ deq g a a2 $ > $ deq g (f @ a) (f2 @ a2) $;
-- beta:  (\T. b) a  =  b[a / 0]
axiom deq_beta (g: ctx) (t b a b2: expr):
  $ sub b a nO b2 $ > $ deq g ((elam t b) @ a) b2 $;
-- iota:  rec C z s 0 = z ;   rec C z s (succ k) = s k (rec C z s k)
axiom deq_iota_zero (g: ctx) (cC z s: expr):
  $ deq g (trec @ cC @ z @ s @ tzero) z $;
axiom deq_iota_succ (g: ctx) (cC z s k: expr):
  $ deq g (trec @ cC @ z @ s @ (tsucc @ k))
          (s @ k @ (trec @ cC @ z @ s @ k)) $;
