-- ============================================================
-- De-Bruijn CIC-fragment prelude in STOCK MM0.
--
-- Mirrors prelude/cic.mm0 (de Bruijn indices, def-eq = reduction), but with
-- `shift`/`subst1` as *provable relations* (out of the trusted base).  No MM0
-- bound variables => no disjoint-variable conditions, no alpha wall.
--
-- This file is PURE AXIOMS (the trusted spec).  db_cert.py generates proofs.
-- iota is GATED on the recursor being well-typed (see deq_iota_* at the end),
-- so it is a sound definitional equality, not an untyped rewrite.
-- ============================================================

delimiter $ ( $ $ ) $;

sort nat;
term nO: nat;
term nS: nat > nat;

sort lvl;
term lz: lvl;
term lS: lvl > lvl;
term lmax:  lvl > lvl > lvl;
term limax: lvl > lvl > lvl;

sort expr;
term evar: nat > expr;
term esort: lvl > expr;
term eapp: expr > expr > expr;
infixl eapp: $@$ prec 100;
term elam: expr > expr > expr;        -- elam DOMAIN BODY  (binder positional)
term epi:  expr > expr > expr;        -- epi  DOMAIN BODY  (dependent function type)
term tnat: expr;
term tzero: expr;
term tsucc: expr;                     -- succ n = eapp tsucc n
term trec: expr;                      -- Nat recursor

sort ctx;
term cnil: ctx;
term ccons: expr > ctx > ctx;         -- context extension  G, T

provable sort wff;

-- ---- nat arithmetic ----
term padd: nat > nat > nat > wff;                       -- i + d = k
axiom padd0 (i: nat): $ padd i nO i $;
axiom paddS (i d k: nat): $ padd i d k $ > $ padd i (nS d) (nS k) $;

term nlt: nat > nat > wff;                              -- a < b
axiom nlt0 (n: nat): $ nlt nO (nS n) $;
axiom nltS (m n: nat): $ nlt m n $ > $ nlt (nS m) (nS n) $;

-- ---- shift:  shf e d c e2  =  (shift indices >= c in e by d) = e2 ----
term shf: expr > nat > nat > expr > wff;
axiom shf_nat  (d c: nat): $ shf tnat  d c tnat  $;
axiom shf_zero (d c: nat): $ shf tzero d c tzero $;
axiom shf_succ (d c: nat): $ shf tsucc d c tsucc $;
axiom shf_rec  (d c: nat): $ shf trec  d c trec  $;
axiom shf_sort (l: lvl) (d c: nat): $ shf (esort l) d c (esort l) $;
axiom shf_app (f a f2 a2: expr) (d c: nat):
  $ shf f d c f2 $ > $ shf a d c a2 $ > $ shf (f @ a) d c (f2 @ a2) $;
axiom shf_lam (t b t2 b2: expr) (d c: nat):
  $ shf t d c t2 $ > $ shf b d (nS c) b2 $ > $ shf (elam t b) d c (elam t2 b2) $;
axiom shf_pi (t b t2 b2: expr) (d c: nat):
  $ shf t d c t2 $ > $ shf b d (nS c) b2 $ > $ shf (epi t b) d c (epi t2 b2) $;
axiom shf_var_0  (i d k: nat): $ padd i d k $ > $ shf (evar i) d nO (evar k) $;
axiom shf_var_S0 (d c: nat): $ shf (evar nO) d (nS c) (evar nO) $;
axiom shf_var_SS (i d c j: nat):
  $ shf (evar i) d c (evar j) $ > $ shf (evar (nS i)) d (nS c) (evar (nS j)) $;

-- ---- subst:  sub b v j b2  =  (substitute v for index j in b) = b2 ----
term sub: expr > expr > nat > expr > wff;
axiom sub_nat  (v: expr) (j: nat): $ sub tnat  v j tnat  $;
axiom sub_zero (v: expr) (j: nat): $ sub tzero v j tzero $;
axiom sub_succ (v: expr) (j: nat): $ sub tsucc v j tsucc $;
axiom sub_rec  (v: expr) (j: nat): $ sub trec  v j trec  $;
axiom sub_sort (l: lvl) (v: expr) (j: nat): $ sub (esort l) v j (esort l) $;
axiom sub_app (f a f2 a2 v: expr) (j: nat):
  $ sub f v j f2 $ > $ sub a v j a2 $ > $ sub (f @ a) v j (f2 @ a2) $;
axiom sub_lam (t b t2 b2 v: expr) (j: nat):
  $ sub t v j t2 $ > $ sub b v (nS j) b2 $ > $ sub (elam t b) v j (elam t2 b2) $;
axiom sub_pi (t b t2 b2 v: expr) (j: nat):
  $ sub t v j t2 $ > $ sub b v (nS j) b2 $ > $ sub (epi t b) v j (epi t2 b2) $;
axiom sub_var_eq (v v2: expr) (j: nat): $ shf v j nO v2 $ > $ sub (evar j) v j v2 $;
axiom sub_var_lt (i j: nat) (v: expr): $ nlt i j $ > $ sub (evar i) v j (evar i) $;
axiom sub_var_gt (i j: nat) (v: expr): $ nlt j (nS i) $ > $ sub (evar (nS i)) v j (evar i) $;

-- ---- definitional equality (reduction), untyped congruence ----
term deq: ctx > expr > expr > wff;
axiom deq_refl  (g: ctx) (e: expr): $ deq g e e $;
axiom deq_sym   (g: ctx) (a b: expr): $ deq g a b $ > $ deq g b a $;
axiom deq_trans (g: ctx) (a b c: expr): $ deq g a b $ > $ deq g b c $ > $ deq g a c $;
axiom deq_app (g: ctx) (f a f2 a2: expr):
  $ deq g f f2 $ > $ deq g a a2 $ > $ deq g (f @ a) (f2 @ a2) $;
axiom deq_pi (g: ctx) (cA cA2 cB cB2: expr):
  $ deq g cA cA2 $ > $ deq (ccons cA g) cB cB2 $ > $ deq g (epi cA cB) (epi cA2 cB2) $;
axiom deq_lam (g: ctx) (cA cA2 cb cb2: expr):
  $ deq g cA cA2 $ > $ deq (ccons cA g) cb cb2 $ > $ deq g (elam cA cb) (elam cA2 cb2) $;
-- beta:  (\T. b) a  =  b[a / 0]
axiom deq_beta (g: ctx) (t b a b2: expr):
  $ sub b a nO b2 $ > $ deq g ((elam t b) @ a) b2 $;

-- ============================================================
-- Typing judgment  ht G e T   ( G |- e : T ),  core CIC rules.
-- ============================================================
term ht: ctx > expr > expr > wff;
axiom ht_sort (g: ctx) (l: lvl): $ ht g (esort l) (esort (lS l)) $;
axiom ht_var0 (g: ctx) (cT cT2: expr):
  $ shf cT (nS nO) nO cT2 $ > $ ht (ccons cT g) (evar nO) cT2 $;
axiom ht_weak (g: ctx) (cS cT cT2: expr) (i: nat):
  $ ht g (evar i) cT $ > $ shf cT (nS nO) nO cT2 $ >
  $ ht (ccons cS g) (evar (nS i)) cT2 $;
axiom ht_pi (g: ctx) (cA cB: expr) (u v: lvl):
  $ ht g cA (esort u) $ > $ ht (ccons cA g) cB (esort v) $ >
  $ ht g (epi cA cB) (esort (limax u v)) $;
axiom ht_lam (g: ctx) (cA cb cB: expr) (u: lvl):
  $ ht g cA (esort u) $ > $ ht (ccons cA g) cb cB $ >
  $ ht g (elam cA cb) (epi cA cB) $;
axiom ht_app (g: ctx) (f a cA cB cB2: expr):
  $ ht g f (epi cA cB) $ > $ ht g a cA $ > $ sub cB a nO cB2 $ >
  $ ht g (f @ a) cB2 $;
axiom ht_conv (g: ctx) (t cT cT2: expr) (u: lvl):
  $ ht g t cT $ > $ deq g cT cT2 $ > $ ht g cT2 (esort u) $ >
  $ ht g t cT2 $;

-- Nat as a typed primitive
axiom ht_nat  (g: ctx): $ ht g tnat (esort (lS lz)) $;
axiom ht_zero (g: ctx): $ ht g tzero tnat $;
axiom ht_succ (g: ctx): $ ht g tsucc (epi tnat tnat) $;

-- The recursor's type:
--   trec : Pi C : (Nat -> Sort u),
--            C 0 -> (Pi n:Nat, C n -> C (succ n)) -> (Pi m:Nat, C m)
-- (de Bruijn; C is index 0 right after its binder, shifting inward.)
axiom ht_rec (g: ctx) (u: lvl):
  $ ht g trec
    (epi (epi tnat (esort u))
         (epi (eapp (evar nO) tzero)
              (epi (epi tnat (epi (eapp (evar (nS (nS nO))) (evar nO))
                                  (eapp (evar (nS (nS (nS nO)))) (eapp tsucc (evar (nS nO))))))
                   (epi tnat (eapp (evar (nS (nS (nS nO)))) (evar nO)))))) $;

-- ============================================================
-- iota, GATED on the recursor being applied to well-typed motive + cases.
-- `ht g (trec @ cC @ z @ s) mt` can only hold via ht_rec + ht_app, which
-- forces cC,z,s to typecheck at the recursor's signature -- so these are
-- sound, type-preserving definitional equalities.
-- ============================================================
axiom deq_iota_zero (g: ctx) (cC z s mt: expr):
  $ ht g (trec @ cC @ z @ s) mt $ >
  $ deq g (trec @ cC @ z @ s @ tzero) z $;
axiom deq_iota_succ (g: ctx) (cC z s k mt: expr):
  $ ht g (trec @ cC @ z @ s) mt $ > $ ht g k tnat $ >
  $ deq g (trec @ cC @ z @ s @ (tsucc @ k))
          (s @ k @ (trec @ cC @ z @ s @ k)) $;
